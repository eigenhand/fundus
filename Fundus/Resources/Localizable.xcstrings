            "value": "Search index"
          }
        }
      }
    },
    "Suchschluessel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search key"
          }
        }
      }
    },
    "Unterort in %@ anlegen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a sub-place in %@"
          }
        }
      }
    },
