    },
    "Aufnahmen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    },
    "Aus dem Sucher: der neue Ort ist danach gewählt. Zurück geht es über die Kamera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the viewfinder: the new place is selected afterwards. The way back is through the camera."
          }
        }
      }
    },
    "Aus der Galerie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the gallery"
          }
        }
      }
    },
    "Ausgabetoken, hoechstens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output tokens, at most"
          }
        }
      }
    },
    "Ausgewählt: %@": {
      "localizations": {
        "en": {
