          "stringUnit": {
            "state": "translated",
            "value": "Places"
          }
        }
      }
    },
    "Pfad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path"
          }
        }
      }
    },
    "Reasoning-Modelle brauchen den Vorrat doppelt — erst zum Nachdenken, dann zum Schreiben. Zu wenig sieht aus wie eine leere Antwort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasoning models need the budget twice — first to think, then to write. Too little looks like an empty answer."
          }
        }
      }
    },
    "Regal fotografieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a shelf"
          }
        }
      }
    },
    "Schluessel-Kopfzeile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key header"
          }
        }
      }
    },
    "Schlüssel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key"
          }
        }
      }
    },
    "Sprache": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "Sprache des Geräts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device language"
          }
        }
      }
    },
    "Steht auf einem Ding eine Herstellernummer, oder entziffert das Geraet einen Strichcode, sucht die App danach und legt bis zu drei Moeglichkeiten vor. Ausgewaehlt ist keine: du tippst die richtige an, oder keine. Die Nummer steht daneben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a thing carries a manufacturer number, or the device makes out a barcode, the app searches for it and offers up to three possibilities. None is selected: you tap the right one, or none. The number stands beside it."
          }
        }
      }
    },
    "Steht in der Reihe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting in the queue."
          }
        }
      }
    },
    "Suche": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        }
      }
    },
    "Suche leeren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the search"
          }
        }
      }
    },
    "Sucher schliessen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the viewfinder"
          }
        }
      }
    },
    "Suchindex": {
      "extractionState": "manual",
      "localizations": {
        "en": {
