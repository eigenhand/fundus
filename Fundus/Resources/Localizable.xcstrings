        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By hand"
          }
        }
      }
    },
    "Was dabei herauskommt, ist ein Vorschlag und ersetzt nichts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What comes out is a suggestion and replaces nothing."
