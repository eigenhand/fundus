            "value": "Place for the photos: %@"
          }
        }
      }
    },
    "Ort für neue Einträge: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place for new entries: %@"
          }
        }
      }
    },
