            "state": "translated",
            "value": "Selected: %@"
          }
        }
      }
    },
    "Auslösen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shutter"
          }
        }
      }
    },
    "BSA…": {
      "localizations": {
