          "stringUnit": {
            "state": "translated",
            "value": "Deselect all"
          }
        }
      }
    },
    "Alle wählen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all"
          }
        }
      }
    },
    "Alles bestätigt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything confirmed"
          }
        }
      }
    },
    "Angelegt %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %@"
          }
        }
      }
    },
    "Apples Modell, 108 MB, 8 ms je Eintrag. Gröber, aber ohne Netz — und ein Keller hat selten Empfang.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model, 108 MB, 8 ms per entry. Coarser, but without a network — and a basement rarely has reception."
          }
        }
      }
    },
    "Auf dem Gerät": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the device"
          }
        }
      }
    },
    "Aufnahme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        }
      }
    },
    "Aufnahmen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    },
    "Aus dem Sucher: der neue Ort ist danach gewählt. Zurück geht es über die Kamera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the viewfinder: the new place is selected afterwards. The way back is through the camera."
          }
        }
      }
    },
    "Aus der Galerie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the gallery"
          }
        }
      }
    },
    "Ausgabetoken, hoechstens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output tokens, at most"
          }
        }
      }
    },
    "Ausgewählt: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected: %@"
          }
        }
      }
    },
    "Auslösen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shutter"
          }
        }
      }
    },
    "BSA…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BSA…"
          }
        }
      }
    },
    "Bei einem vollen Regal dauert das eine halbe Minute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a full shelf that takes half a minute."
          }
        }
      }
    },
    "Beleg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence"
          }
        }
      }
    },
    "Belege": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence"
          }
        }
      }
    },
    "Bestand ausgeben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the inventory"
          }
        }
      }
    },
    "Bilder prüfen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the images"
          }
        }
      }
    },
    "Blitz: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flash: %@"
          }
        }
      }
    },
    "Da war keine Kante zu finden. Tippe mitten auf das Ding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no edge to find. Tap the middle of the thing."
          }
        }
      }
    },
    "Das Bild wird vorbereitet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture is being prepared."
          }
        }
      }
    },
    "Das Foto bleibt erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is kept."
          }
        }
      }
    },
    "Das Modell hat das Foto gelesen und nichts darauf gefunden, was in einen Bestand gehört.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model read the photo and found nothing on it that belongs in an inventory."
          }
        }
      }
    },
    "Das Modell hat es gesehen, konnte es aber nicht benennen. Hier musst du selbst nachsehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model saw it but could not name it. Here you have to look yourself."
          }
        }
      }
    },
    "Das Modell hat keinen Text geliefert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model delivered no text."
          }
        }
      }
    },
    "Das Modell hat nur nachgedacht (%lld Zeichen) und keine Antwort geschrieben. Meist hilft ein höheres Token-Limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model only thought (%lld characters) and wrote no answer. A higher token limit usually helps."
          }
        }
      }
    },
    "Das Modell liegt auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is on the device."
          }
        }
      }
    },
    "Das Modell sieht sich das Bild an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is looking at the picture."
          }
        }
      }
    },
    "Das lokale Modell ist noch nicht geladen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model is not downloaded yet."
          }
        }
      }
    },
    "Der Anbieter drosselt gerade (HTTP %lld) — auch nach zwei Wartepausen noch. Kurz warten hilft. Kommt es oft vor, in den Einstellungen unter „Aufnahme“ weniger Fotos gleichzeitig lesen lassen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is throttling right now (HTTP %lld) — still, after two waits. Waiting a moment helps. If it happens often, have fewer photos read at once under “Capture” in the settings."
          }
        }
      }
    },
    "Der Kasten ist zu klein — daraus liest auch das Modell nichts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The box is too small — the model reads nothing out of it either."
          }
        }
      }
    },
    "Der Ort und alle Unterorte werden gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place and all its sub-places are deleted."
          }
        }
      }
    },
    "Der Ort und alle Unterorte werden gelöscht. %lld %@ danach nirgends — gelöscht wird davon nichts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Der Ort und alle Unterorte werden gelöscht. %1$lld %2$@ danach nirgends — gelöscht wird davon nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place and all its sub-places are deleted. %lld %@ nowhere afterwards — none of them is deleted."
          }
        }
      }
    },
    "Die Antwort war nicht das erwartete JSON: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer was not the expected JSON: %@"
          }
        }
      }
    },
    "Die Antwort wurde bei %lld Token abgeschnitten, bevor Text kam. Das Modell hat vorher %lld Zeichen nachgedacht — Reasoning-Modelle brauchen die Token doppelt. In den Einstellungen mehr Ausgabetoken erlauben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Die Antwort wurde bei %1$lld Token abgeschnitten, bevor Text kam. Das Modell hat vorher %2$lld Zeichen nachgedacht — Reasoning-Modelle brauchen die Token doppelt. In den Einstellungen mehr Ausgabetoken erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer was cut off at %lld tokens before any text came. The model had thought for %lld characters first — reasoning models need the tokens twice. Allow more output tokens in the settings."
          }
        }
      }
    },
    "Die Antwort wurde bei %lld Token abgeschnitten, bevor Text kam. In den Einstellungen mehr Ausgabetoken erlauben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer was cut off at %lld tokens before any text came. Allow more output tokens in the settings."
          }
        }
      }
    },
    "Die Namenssuche läuft immer und braucht nichts. Für die Suche nach Bedeutung — „das Kabel mit dem eckigen Stecker“ — werden Vektoren gebraucht, und die kommen von hier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search by name always runs and needs nothing. Searching by meaning — “the cable with the square plug” — takes vectors, and those come from here."
          }
        }
      }
    },
    "Diesen Eintrag löschen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this entry?"
          }
        }
      }
    },
    "Dieser Eintrag ist gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry is deleted."
          }
        }
      }
    },
    "Dieses Gerät kennt das lokale Modell nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not know the local model."
          }
        }
      }
    },
    "Dunkel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        }
      }
    },
    "Ein Lagerbestand fürs iPhone, der nichts mitbringt außer der Oberfläche. Modell, Endpoint und Schlüssel kommen von dir. Kein Konto, kein Zwischenserver, keine Telemetrie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inventory for the iPhone that brings nothing but the interface. The model, the endpoint and the key come from you. No account, no server in between, no telemetry."
          }
        }
      }
    },
    "Ein Ort ist, wo etwas liegt: Keller, Regal 2, Kiste C. Ohne Orte geht es auch — dann liegt alles auf einem Haufen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place is where something lies: basement, shelf 2, box C. It works without places too — then everything lies in one heap."
          }
        }
      }
    },
    "Einbettung fehlgeschlagen: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedding failed: %@"
          }
        }
      }
    },
    "Einbettungsmodell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedding model"
          }
        }
      }
    },
    "Einheit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit"
          }
        }
      }
    },
    "Einige Treffer kommen aus der Bedeutung, nicht aus dem Namen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some results come from meaning, not from the name."
          }
        }
      }
    },
    "Einstellungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Eintrag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry"
          }
        }
      }
    },
    "Eintragen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter"
          }
        }
      }
    },
    "Entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Erscheinungsbild": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "Es schreibt — %lld Zeichen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is writing — %lld characters."
          }
        }
      }
    },
    "Es werden %lld Fotos gleichzeitig gelesen. In den Einstellungen änderbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld photos are read at once. Changeable in the settings."
          }
        }
      }
    },
    "Fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Fotografiere ein Regal, eine Schublade, eine Kiste. Dein Modell liest, was darauf ist, und du hakst ab, was stimmt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a shelf, a drawer, a box. Your model reads what is on it, and you tick off what is right."
          }
        }
      }
    },
    "Fotografieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph"
          }
        }
      }
    },
    "Fotos kommen in eine Reihe und werden nebeneinander gelesen. Mehr gleichzeitig heisst frueher fertig — bis der Anbieter drosselt. Wer 429 oder Zeitablaeufe sieht, stellt es herunter. Die Reihe fasst %lld Aufnahmen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos go into a queue and are read side by side. More at once means finished sooner — until the provider throttles. If you see 429s or timeouts, turn it down. The queue holds %lld photos."
          }
        }
      }
    },
    "Fotos: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos: %@"
          }
        }
      }
    },
    "Fundus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundus"
          }
        }
      }
    },
    "Gegenstaende erkennen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect objects"
          }
        }
      }
    },
    "Gegenstand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Object"
          }
        }
      }
    },
    "Gelesen von %@. Was du übernimmst, behält das als Herkunft und dieses Foto als Beleg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read by %@. Whatever you accept keeps that as its origin and this photo as the evidence."
          }
        }
      }
    },
    "Genauer, kostet aber bei jeder Suche eine Anfrage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More precise, but costs a request on every search."
          }
        }
      }
    },
    "Gesehen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen"
          }
        }
      }
    },
    "Gewählt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen"
          }
        }
      }
    },
    "Gilt für die Oberfläche. Systemdialoge — etwa die Frage nach der Kamera — folgen weiterhin der Spracheinstellung des Geräts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the interface. System dialogs — the camera prompt, for instance — still follow the device's language setting."
          }
        }
      }
    },
    "Gleichzeitig lesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read at once"
          }
        }
      }
    },
    "HTTP %lld\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "HTTP %1$lld\n%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP %lld\n%@"
          }
        }
      }
    },
    "Hell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        }
      }
    },
    "Herkunft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin"
          }
        }
      }
    },
    "Im Index liegen:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the index:"
          }
        }
      }
    },
    "Im Objekte-Modus tippst du auf ein Ding, und das Geraet sagt, wo es aufhoert. Liegt auf dem Geraet (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In object mode you tap a thing and the device says where it ends. It lives on the device (%@)."
          }
        }
      }
    },
    "Im Suchindex: %@, %@ Dimensionen": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Im Suchindex: %1$@, %2$@ Dimensionen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the search index: %@, %@ dimensions"
          }
        }
      }
    },
    "Im Suchindex: %@, %lld Dimensionen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Im Suchindex: %1$@, %2$lld Dimensionen"
          }
        },
        "en": {
          "stringUnit": {
