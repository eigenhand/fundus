    "Aufnahme, Nummern werden nachgeschlagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, looking up numbers"
          }
        }
      }
    },
    "Aufnahme, wartet in der Reihe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, waiting in the queue"
          }
