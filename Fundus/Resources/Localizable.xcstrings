            "state": "translated",
            "value": "Origin"
          }
        }
      }
    },
    "Herstellernummer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part number"
          }
        }
      }
    },
    "Im Index liegen:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the index:"
          }
        }
      }
    },
    "Im Objekte-Modus tippst du auf ein Ding, und das Geraet sagt, wo es aufhoert. Liegt auf dem Geraet (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In object mode you tap a thing and the device says where it ends. It lives on the device (%@)."
          }
        }
      }
    },
    "Im Suchindex: %@, %@ Dimensionen": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Im Suchindex: %1$@, %2$@ Dimensionen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the search index: %@, %@ dimensions"
          }
        }
      }
    },
    "Im Suchindex: %@, %lld Dimensionen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Im Suchindex: %1$@, %2$lld Dimensionen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the search index: %@, %lld dimensions"
          }
        }
      }
    },
    "Index gelöscht. Die Namenssuche findet weiter alles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index deleted. Name search still finds everything."
          }
        }
      }
    },
    "Index löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the index"
          }
        }
      }
    },
    "Index: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index: %@"
          }
        }
      }
    },
    "Index: unerwartete Anzahl Vektoren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index: unexpected number of vectors."
          }
        }
      }
    },
    "Ist es das?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this it?"
          }
        }
      }
    },
    "Kante suchen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for the edge …"
          }
        }
      }
    },
    "Kein Bestand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No inventory"
          }
        }
      }
    },
    "Kein Bild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No image."
          }
        }
      }
    },
    "Kein Eintrag ist älter als ein halbes Jahr.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entry is older than half a year."
          }
        }
      }
    },
    "Kein Eintrag wird angerührt. Die Namenssuche findet weiter alles, die Suche nach Bedeutung nicht mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entry is touched. The search by name still finds everything, the search by meaning no longer does."
          }
        }
      }
    },
    "Kein Modell eingerichtet — ohne Endpoint kann niemand das Foto lesen. Einrichten unter Einstellungen → Modell.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model set up — without an endpoint nothing can read the photo. Set it up under Settings → Model."
          }
        }
      }
    },
    "Kein Modell eingerichtet. Endpoint, Schlüssel und Modellname fehlen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model set up. The endpoint, the key and the model name are missing."
          }
        }
      }
    },
    "Kein Schlüssel im Schlüsselbund hinterlegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key deposited in the keychain."
          }
        }
      }
    },
    "Kein Treffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No match"
          }
        }
      }
    },
    "Kein Vektor erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No vector received."
          }
        }
      }
    },
    "Keine HTTP-Antwort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No HTTP response."
          }
        }
      }
    },
    "Keine Orte": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No places"
          }
        }
      }
    },
    "Keine Tokenvektoren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No token vectors."
          }
        }
      }
    },
    "Keine einzelnen Gegenstände erkannt — das ganze Bild geht als eine Aufnahme. Mit dem Erkennungsmodell aus den Einstellungen ginge das besser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No individual objects detected — the whole image goes as one capture. The detection model from the settings would do this better."
          }
        }
      }
    },
    "Kennung": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifier"
          }
        }
      }
    },
    "Kennungen im Netz aufloesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up identifiers online"
          }
        }
      }
    },
    "Klartext-JSON. Der Bestand gehört dir, nicht dieser App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain JSON. The inventory is yours, not this app's."
          }
        }
      }
    },
    "Laden (80 MB)": {
      "localizations": {
        "en": {
          "stringUnit": {
