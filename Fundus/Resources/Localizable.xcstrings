            "value": "Added %@"
          }
        }
      }
    },
    "Apples Modell, 108 MB, 8 ms je Eintrag. Gröber, aber ohne Netz — und ein Keller hat selten Empfang.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model, 108 MB, 8 ms per entry. Coarser, but without a network — and a basement rarely has reception."
          }
        }
      }
    },
    "Auf dem Gerät": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the device"
          }
        }
      }
    },
    "Aufnahme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        }
      }
    },
    "Aufnahme fehlgeschlagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture failed"
          }
        }
      }
    },
    "Aufnahme gelesen — %lld Vorschläge zum Prüfen.": {
      "localizations": {
