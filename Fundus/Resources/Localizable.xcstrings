            "value": "Increase the quantity"
          }
        }
      }
    },
    "Menge ungezählt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantity not counted"
          }
        }
      }
    },
    "Menge verringern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrease the quantity"
          }
        }
      }
    },
    "Mit Spind und Faden teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with Spind and Faden"
          }
        }
      }
    },
    "Modell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model"
          }
        }
      }
    },
    "Nachgeschlagen — %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looked up — %@."
          }
        }
      }
    },
    "Name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Neue Einträge automatisch einbetten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embed new entries automatically"
          }
        }
      }
    },
    "Nicht bestimmbar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot be determined"
          }
        }
      }
    },
    "Nicht gelesen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read"
          }
        }
      }
    },
    "Nicht im Suchindex — über den Namen findbar, nicht über die Bedeutung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in the search index — findable by name, not by meaning."
          }
        }
      }
    },
    "Nicht mehr da": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gone"
          }
        }
      }
    },
    "Nicht unterordnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not nest"
          }
        }
      }
    },
    "Nichts im Bestand passt zu diesem Wort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in the inventory matches this word."
          }
        }
      }
    },
    "Notiz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note"
          }
        }
      }
    },
    "Nummern nachschlagen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up numbers"
          }
        }
      }
